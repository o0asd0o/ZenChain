#!/usr/bin/env bash
# zenchain-agent — dispatch a normalized role request through a harness adapter.
#
# Usage: zenchain-agent <role> [--cwd DIR] [--backend NAME] <prompt...>
#        echo "$LONG_PROMPT" | zenchain-agent explorer
#
# Adapters receive ZENCHAIN_AGENT_* environment variables. Built-in adapters are
# aliases; any executable named zenchain-adapter-NAME can implement the contract.
#
# Exit codes: 0 report on stdout · 2 usage/config error · 3 backend produced
# nothing (see EMPTY OUTPUT below).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
CONFIG="$REPO_ROOT/.zenchain/config.env"
[[ -f "$CONFIG" ]] && { set -a; . "$CONFIG"; set +a; }

ROLE="${1:?usage: zenchain-agent <role> [--cwd DIR] [--backend NAME] <prompt...>}"; shift
CWD="$REPO_ROOT"; BACKEND=""
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --cwd)     CWD="$2"; shift 2 ;;
    --backend) BACKEND="$2"; shift 2 ;;
    *) echo "zenchain-agent: unknown flag $1" >&2; exit 2 ;;
  esac
done

ROLE_DIRS=()
for configured in "${ZENCHAIN_ROLE_DIR:-}" "${ZENCHAIN_MECH_ROLE_DIR:-}" "${ZENCHAIN_RUNNER_ROLE_DIR:-}" ".zenchain/agents" ".claude/agents"; do
  [[ -n "$configured" ]] || continue
  [[ " ${ROLE_DIRS[*]-} " == *" $configured "* ]] || ROLE_DIRS+=("$configured")
done
AGENT_FILE=""
for role_dir in "${ROLE_DIRS[@]}"; do
  candidate="$role_dir/$ROLE.md"
  [[ "$candidate" = /* ]] || candidate="$REPO_ROOT/$candidate"
  if [[ -f "$candidate" ]]; then AGENT_FILE="$candidate"; break; fi
done
[[ -n "$AGENT_FILE" ]] || { echo "zenchain-agent: no role file for '$ROLE' in ${ROLE_DIRS[*]}" >&2; exit 2; }

PROMPT="$*"
[[ -z "$PROMPT" && ! -t 0 ]] && PROMPT="$(cat)"
[[ -n "$PROMPT" ]] || { echo "zenchain-agent: empty prompt" >&2; exit 2; }

# Frontmatter (between the first two --- lines) gives model + tools; the body
# after the second --- is the system prompt.
MODEL="$(sed -n '/^---$/,/^---$/p' "$AGENT_FILE" | sed -n 's/^model:[[:space:]]*//p' | head -1)"
TOOLS="$(sed -n '/^---$/,/^---$/p' "$AGENT_FILE" | sed -n 's/^tools:[[:space:]]*//p' | head -1 | tr -d ' ')"
EFFORT="$(sed -n '/^---$/,/^---$/p' "$AGENT_FILE" | sed -n 's/^effort:[[:space:]]*//p' | head -1 | tr -d ' ')"
EFFORT="${ZENCHAIN_AGENT_EFFORT:-$EFFORT}"
BODY="$(awk 'BEGIN{n=0} n<2 && /^---$/{n++; next} n>=2{print}' "$AGENT_FILE")"

MODEL="${ZENCHAIN_AGENT_MODEL:-$MODEL}"
[[ "$MODEL" == inherit || "$MODEL" == default ]] && MODEL=""

if [[ -z "$BACKEND" ]]; then
  case "$ROLE" in
    implementer|fixer|explorer) BACKEND="${ZENCHAIN_RUNNER_MECH:-claude}" ;;
    *)                          BACKEND="${ZENCHAIN_RUNNER:-claude}" ;;
  esac
fi

SYS_FILE="$(mktemp -t zenchain-agent-sys.XXXXXX)"
PROMPT_FILE="$(mktemp -t zenchain-agent-prompt.XXXXXX)"
OUT_FILE="$(mktemp -t zenchain-agent-out.XXXXXX)"
trap 'rm -f "$SYS_FILE" "$PROMPT_FILE" "$OUT_FILE"' EXIT
printf '%s\n' "$BODY" >"$SYS_FILE"
printf '%s\n' "$PROMPT" >"$PROMPT_FILE"

ADAPTER_PREFIX="${ZENCHAIN_ADAPTER_PREFIX:-zenchain-adapter-}"
ADAPTER_DIR="${ZENCHAIN_ADAPTER_DIR:-.zenchain/adapters}"
ADAPTER=""
if [[ "$ADAPTER_DIR" = /* ]]; then
  [[ -x "$ADAPTER_DIR/$BACKEND" ]] && ADAPTER="$ADAPTER_DIR/$BACKEND"
else
  [[ -x "$REPO_ROOT/$ADAPTER_DIR/$BACKEND" ]] && ADAPTER="$REPO_ROOT/$ADAPTER_DIR/$BACKEND"
fi
if [[ -z "$ADAPTER" && -x "$SCRIPT_DIR/$ADAPTER_PREFIX$BACKEND" ]]; then
  ADAPTER="$SCRIPT_DIR/$ADAPTER_PREFIX$BACKEND"
fi
[[ -n "$ADAPTER" ]] || ADAPTER="$(command -v "$ADAPTER_PREFIX$BACKEND" 2>/dev/null || true)"
[[ -x "$ADAPTER" ]] || { echo "zenchain-agent: no adapter for '$BACKEND' (expected ${ADAPTER_PREFIX}${BACKEND})" >&2; exit 2; }

cd "$CWD"
set +e
ZENCHAIN_AGENT_ROLE="$ROLE" \
ZENCHAIN_AGENT_CWD="$CWD" \
ZENCHAIN_AGENT_MODEL="$MODEL" \
ZENCHAIN_AGENT_TOOLS="$TOOLS" \
ZENCHAIN_AGENT_EFFORT="$EFFORT" \
ZENCHAIN_AGENT_SYSTEM_FILE="$SYS_FILE" \
ZENCHAIN_AGENT_PROMPT_FILE="$PROMPT_FILE" \
ZENCHAIN_AGENT_REPO_ROOT="$REPO_ROOT" \
ZENCHAIN_AGENT_BACKEND="$BACKEND" \
  "$ADAPTER" >"$OUT_FILE" 2>&1
STATUS=$?
set -e

cat "$OUT_FILE"

# EMPTY OUTPUT is a failure, not a success. A backend that has run out of
# credit, lost its auth, or died on a transport error can exit 0 with nothing on
# stdout — which reads to the orchestrator as a clean run that found nothing to
# do. Fail loudly instead.
if [[ ! -s "$OUT_FILE" ]]; then
  echo "zenchain-agent: $BACKEND produced NO output for role '$ROLE' (exit $STATUS)." >&2
  echo "zenchain-agent: treat this as a failed dispatch, not an empty result. Check auth/credit on '$BACKEND' before respawning." >&2
  exit 3
fi
exit $STATUS
