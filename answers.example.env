# orc2 answers — pass with `orc2 init --answers this-file.env` to skip the interview.
# This example reproduces the setup the pipeline was extracted from: markdown
# issues, a Figma contract, Claude judging, cheap external models building,
# two lanes with isolated databases, and a Slack ping at the checkpoint.

ORC2_PROJECT="fashio"

# scratch | github
ORC2_TRACKER="scratch"

# figma | lofi | none
ORC2_DESIGN="figma"
ORC2_FIGMA_FILE_KEY="Fg4bIdCYCFMuSer6fZa8zj"
ORC2_FIGMA_ROOT_NODE="1:645"
# ORC2_LOFI_DIR="design/lofi"          # when ORC2_DESIGN="lofi"

# claude | codex — runs the orchestrator and the judgement roles
ORC2_RUNNER="claude"
# claude | codex | pi — runs implementer, fixer, explorer
ORC2_RUNNER_MECH="pi"

# Blank means "whatever the backend is configured to use".
ORC2_MODEL_JUDGE="claude-opus-4-8"
ORC2_MODEL_GATE="claude-opus-5"
ORC2_MODEL_BUILD="opencode-go/kimi-k2.7-code:medium"
ORC2_MODEL_SCAN="opencode-go/deepseek-v4-flash:low"

# The gate. Semicolon-separated, run in this order, by the orchestrator itself.
ORC2_GATE="vp check; vp run -r check; vp run -r test; vp run -r build"

ORC2_MAIN_BRANCH="main"
ORC2_WORKTREE_DIR=".worktrees"

# 1 | 2
ORC2_LANES="2"

# none | sqlite | postgres   (legacy yes/no still maps to postgres/none)
# This saved config is the factual authority for the current engine.
ORC2_DB="postgres"
ORC2_DEV_DB="fashio_dev"          # sqlite: a file path, e.g. data/fashio.db
ORC2_LANE_PREFIX="fashio_lane_"   # sqlite: a path prefix, e.g. data/lane-
ORC2_DB_URI_VAR="DATABASE_URI"

# yes | no — generated types, clients, ordered migration barrels
ORC2_CODEGEN="yes"
ORC2_CODEGEN_CMD="vp run cms#generate:types"
ORC2_MIGRATE_CMD="bun x payload migrate"
ORC2_MIGRATE_STATUS_CMD="bun x payload migrate:status"
ORC2_GENERATED_PATHS="apps/cms/src/payload-types.ts, apps/cms/src/migrations/index.ts"

# none | slack | push
ORC2_NOTIFY="slack"
ORC2_SLACK_ENV="SLACK_WEBHOOK_URL"
ORC2_SLACK_CHANNEL="#fashio"
ORC2_SLACK_MENTION=""

ORC2_ROUND_CAP="3"
ORC2_A11Y="WCAG 2.2 AA"
ORC2_BUILD_ORDER="Foundation → Catalog → {Browsing, Promotions, Content} → Ordering → {Identity, Fulfilment} → Reviews & Wishlist."
ORC2_PIPELINE_DIR=".orc2"

# Engineering skills the roles drive. Leave the pin blank on a first run and orc2
# resolves upstream main, then records the sha here so re-renders reproduce it.
# Re-pin deliberately: clear the value and `orc2 render` — never mid-run, because
# a role prompt and the skill it cites should not change under a building lane.
ORC2_SKILLS_REPO="mattpocock/skills"
ORC2_SKILLS_PIN=""

# Where the `## Agent skills` block goes. Leave blank for the default wiring:
# the block lives in AGENTS.md (the cross-tool convention, read directly by
# Codex), and CLAUDE.md gets a line reading `@AGENTS.md` so Claude Code loads it
# too. One source of truth, and switching ORC2_RUNNER later changes nothing.
# Set a path to override — then the block goes there verbatim, with no import
# wiring, because you have said where it belongs.
ORC2_AGENTS_FILE=""
