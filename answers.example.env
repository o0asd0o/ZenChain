# zenchain answers — pass with `zenchain init --answers this-file.env` to skip the interview.
# This example reproduces the setup the pipeline was extracted from: markdown
# issues, a Figma contract, Claude judging, cheap external models building,
# two lanes with isolated databases, and a Slack ping at the checkpoint.

ZENCHAIN_PROJECT="fashio"

# scratch | github
ZENCHAIN_TRACKER="scratch"

# figma | lofi | none
ZENCHAIN_DESIGN="figma"
ZENCHAIN_FIGMA_FILE_KEY="Fg4bIdCYCFMuSer6fZa8zj"
ZENCHAIN_FIGMA_ROOT_NODE="1:645"
# ZENCHAIN_LOFI_DIR="design/lofi"          # when ZENCHAIN_DESIGN="lofi"

# claude | codex — runs the orchestrator and the judgement roles
ZENCHAIN_RUNNER="claude"
# claude | codex | pi — runs implementer, fixer, explorer
ZENCHAIN_RUNNER_MECH="pi"

# Blank means "whatever the backend is configured to use".
ZENCHAIN_MODEL_JUDGE="claude-opus-4-8"
ZENCHAIN_MODEL_GATE="claude-opus-5"
ZENCHAIN_MODEL_BUILD="opencode-go/kimi-k2.7-code:medium"
ZENCHAIN_MODEL_SCAN="opencode-go/deepseek-v4-flash:low"

# The gate. Semicolon-separated, run in this order, by the orchestrator itself.
ZENCHAIN_GATE="vp check; vp run -r check; vp run -r test; vp run -r build"

# enforced | off — enforced is effective only when package.json exists.
ZENCHAIN_ANTI_SLOP="enforced"

ZENCHAIN_MAIN_BRANCH="main"
ZENCHAIN_WORKTREE_DIR=".worktrees"

# 1 | 2
ZENCHAIN_LANES="2"

# none | sqlite | postgres   (legacy yes/no still maps to postgres/none)
# This saved config is the factual authority for the current engine.
ZENCHAIN_DB="postgres"
ZENCHAIN_DEV_DB="fashio_dev"          # sqlite: a file path, e.g. data/fashio.db
ZENCHAIN_LANE_PREFIX="fashio_lane_"   # sqlite: a path prefix, e.g. data/lane-
ZENCHAIN_DB_URI_VAR="DATABASE_URI"

# yes | no — generated types, clients, ordered migration barrels
ZENCHAIN_CODEGEN="yes"
ZENCHAIN_CODEGEN_CMD="vp run cms#generate:types"
ZENCHAIN_MIGRATE_CMD="bun x payload migrate"
ZENCHAIN_MIGRATE_STATUS_CMD="bun x payload migrate:status"
ZENCHAIN_GENERATED_PATHS="apps/cms/src/payload-types.ts, apps/cms/src/migrations/index.ts"

# none | slack | push
ZENCHAIN_NOTIFY="slack"
ZENCHAIN_SLACK_ENV="SLACK_WEBHOOK_URL"
ZENCHAIN_SLACK_CHANNEL="#fashio"
ZENCHAIN_SLACK_MENTION=""

ZENCHAIN_ROUND_CAP="3"
ZENCHAIN_A11Y="WCAG 2.2 AA"
ZENCHAIN_BUILD_ORDER="Foundation → Catalog → {Browsing, Promotions, Content} → Ordering → {Identity, Fulfilment} → Reviews & Wishlist."
ZENCHAIN_PIPELINE_DIR=".zenchain"

# Engineering skills the roles drive. Leave the pin blank on a first run and zenchain
# resolves upstream main, then records the sha here so re-renders reproduce it.
# Re-pin deliberately: clear the value and `zenchain render` — never mid-run, because
# a role prompt and the skill it cites should not change under a building lane.
ZENCHAIN_SKILLS_REPO="mattpocock/skills"
ZENCHAIN_SKILLS_PIN=""

# Where the `## Agent skills` block goes. Leave blank for the default wiring:
# the block lives in AGENTS.md (the cross-tool convention, read directly by
# Codex), and CLAUDE.md gets a line reading `@AGENTS.md` so Claude Code loads it
# too. One source of truth, and switching ZENCHAIN_RUNNER later changes nothing.
# Set a path to override — then the block goes there verbatim, with no import
# wiring, because you have said where it belongs.
ZENCHAIN_AGENTS_FILE=""
